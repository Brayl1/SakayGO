# Express/Vercel administrator access key: use a long random secret, never VITE_*.
SAKAYGO_ADMIN_TOKEN=
# npm run server loads .env. Preview requires node --env-file=.env.
# Hosted owner email is a server-only runtime secret, never VITE_*.
SAKAYGO_ADMIN_EMAIL=brylle
SAKAYGO_LOCAL_ADMIN=brylle12x
# Current app: optional Supabase PostgreSQL instead of R2/local files.
# Set BOTH only after db/supabase-setup.sql and state import succeed.
# Server-only: never use a VITE_ prefix for this key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEOSEARCH_URL=https://photon.komoot.io/api/
GEOSEARCH_ATTRIBUTION=Photon / OpenStreetMap contributors
# Optional HTTPS adapter, see README:
WALK_ROUTER_URL=
WALK_ROUTER_TOKEN=
# Legacy Express prototype only:
PORT=3001
DATABASE_URL=postgresql://sakaygo:change-me@localhost:5432/sakaygo

# KaSakay: server-only Gemini Developer API, non-billed free-tier project only.
# Never use a VITE_ prefix. See docs/kasakay.md before activation.
GEMINI_API_KEY=
GEMINI_FREE_TIER_ENABLED=false